{
  "manifest_version": 3,
  "name": "Funil Tracker – Analisador de Anúncios",
  "version": "1.0.0",
  "description": "Analisa páginas de anúncios em tempo real (exit intent, back-redirect) e salva os resultados no Supabase do Funil Tracker.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["supabase-config.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Funil Tracker – status da análise nesta aba",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
